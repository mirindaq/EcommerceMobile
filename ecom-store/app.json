{
  "expo": {
    "name": "EcomStore",
    "slug": "ecom-store",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "ecom-store",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/logo.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/logo.png"
      },
      "notification": {
        "icon": "./assets/images/logo.png",
        "color": "#E6F4FE"
      },
      "softwareKeyboardLayoutMode": "pan",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "usesCleartextTraffic": true,
      "package": "com.mirindaq.ecomstore"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6fb1cac4-5ed0-4048-9f1b-3c6f941388ff"
      },
      "googleOAuth": {
        "clientId": "1016910487500-nnlhg4vsei85rkvj6r4qs4bel9tqcsoo.apps.googleusercontent.com",
        "projectId": "ecomstore-27a0c"
      },
      "apiConfig": {
        "localIp": "192.168.1.100",
        "port": "8080",
        "apiPrefix": "/api/v1",
        "timeout": 10000,
        "previewUrl": "https://api.mirindaq-dev.shop/api/v1",
        "previewWsUrl": "https://api.mirindaq-dev.shop/ws",
        "devApiUrl": "http://192.168.1.100:8080/api/v1",
        "devWsUrl": "http://192.168.1.100:8080/ws"
      }
    },
    "owner": "mirindaq"
  }
}
